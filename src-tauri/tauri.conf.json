{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FstDict",
  "version": "0.0.19",
  "identifier": "FstDict",
  "build": {
    "beforeDevCommand": "npm run dev:all",
    "devUrl": "http://localhost:9595",
    "beforeBuildCommand": "npm run build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "resources": [
      "sidecars/**/*"
    ],
    "externalBin": [
      "binaries/fstdict-helper"
    ],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
