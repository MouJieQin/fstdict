{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FstDict",
  "version": "0.0.32",
  "identifier": "FstDict",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:9595",
    "beforeBuildCommand": "npm run build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "resources": [
      "sidecars/**/*"
    ],
    "externalBin": [
      "binaries/fstdict-helper"
    ],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1RDExQ0RGNTRBNjc1QzQKUldURWRhWlUzeHpSVmR3cVA5azBEREhTVXgvUlFwNUJwaFBsRS9rTFlUMk5yNVZhL2tKQmtJWHIK",
      "endpoints": [
        "https://github.com/MouJieQin/fstdict/releases/latest/download/latest.json"
      ]
    }
  }
}
