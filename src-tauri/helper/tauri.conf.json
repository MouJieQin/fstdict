{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FstDict Helper",
  "version": "0.0.18",
  "identifier": "FstDict.Helper",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 900,
        "height": 500,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
